# dashboard/local.env.example
# Шаблон окружения для запуска Диспетчерской НА ЛОКАЛЬНОЙ МАШИНЕ, без Docker.
#
# Зачем нужен: дефолтные пути в config.py — серверные (/home/user/stroy-resurs/mvp/...).
# На Windows они разворачиваются в C:\home\user\... и данные растекаются мимо проекта.
# Переменные ниже возвращают все каталоги внутрь каталога mvp.
#
# Использование (PowerShell, из каталога mvp):
#   Copy-Item dashboard\local.env.example dashboard\local.env
#   # отредактируйте пути и токен, затем:
#   Get-Content dashboard\local.env | Where-Object {$_ -match '^\s*[A-Z]' } | ForEach-Object {
#       $k,$v = $_ -split '=',2; Set-Item -Path "Env:$k" -Value $v }
#   py -3.10 -m uvicorn dashboard.app:app --host 127.0.0.1 --port 5510
#
# local.env добавлен в .gitignore и на сервер не уезжает.

# --- обязательное ------------------------------------------------------------
# Токен оператора: без него ВСЕ эндпоинты отвечают 503 (§9).
DASHBOARD_TOKEN=смените-этот-токен

# --- каталоги (заменить <MVP> на абсолютный путь к каталогу mvp) --------------
LOGS_DIR=<MVP>/logs
BASE_DIR=<MVP>/Base
REPORTS_DIR=<MVP>/Reports
DOCUMENTS_DIR=<MVP>/Documents
VECTOR_DB_PATH=<MVP>/VectorDB
GRAPH_DB_PENDING_DIR=<MVP>/GraphDB_Pending
GRAPH_DB_ARCHIVE_DIR=<MVP>/GraphDB_Arch
GRAPH_DB_JSON_OUTPUT_DIR=<MVP>/GraphDB_JSON
PROFILES_DIR=<MVP>/profiles

# Ситлист — таблица public.companies в Postgres. Строка подключения с паролем:
# держите её в mvp/.env (в .gitignore), сюда не копируйте.
# SITE_LIST_DSN=postgresql://postgres:ПАРОЛЬ@192.168.0.123:5432/Test_sitelist

# --- что запускает кнопка «Старт» --------------------------------------------
# Настоящий пайплайн требует Playwright, LibreOffice и доступ к LLM-шлюзу.
# Для репетиции сценариев стоп/рестарт/зависание — эмулятор:
PIPELINE_CMD=dashboard/fake_pipeline.py
FAKE_SECONDS_PER_COMPANY=6
FAKE_ZERO_EVERY=3
FAKE_FAIL_EVERY=4
# FAKE_HANG_AFTER=2      # раскомментировать для проверки сторожа (§5)

# --- сторож (§5) --------------------------------------------------------------
# Локально порог занижен, чтобы «зависание» ловилось за минуты, а не за час.
# Тот же порог читает сторож D101 внутри пайплайна; панель добавляет к нему
# WATCHDOG_GRACE_SECONDS (в проде 300, локально 0).
COMPANY_IDLE_TIMEOUT_SECONDS=120
WATCHDOG_GRACE_SECONDS=0
WATCHDOG_AUTORESTART=false
WATCHDOG_ALERT_PACHCA=false

# --- внешние сервисы ----------------------------------------------------------
GRAPH_DB_API_URL=http://192.168.0.123:4242/api/companies
BOT_URL=http://127.0.0.1:5500/
